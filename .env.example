# Zyro Cloud — environment template.
# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
# Every variable here is read somewhere in app/, lib/ or components/.

# ─── Supabase ──────────────────────────────────────────────────────────────────
# The anon key is browser-safe and subject to RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-anon-key

# REQUIRED. Server routes have no user session, so the anon key is blocked by RLS
# and returns zero rows with no error — which is how the dashboard reported
# "Rs 0" and Shopify tokens failed to save. Secret: server only, never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fallbacks used when the NEXT_PUBLIC_ pair is absent. Usually left unset.
SUPABASE_URL=
SUPABASE_KEY=

# ─── Shopify ───────────────────────────────────────────────────────────────────
# From the app in your Partner/Dev dashboard. The secret also signs webhooks — if
# it belongs to a different app than the one installed, every webhook is rejected
# with 401 and orders silently never arrive.
SHOPIFY_API_KEY=your-shopify-client-id
SHOPIFY_API_SECRET=your-shopify-client-secret

# ─── Scheduled jobs ────────────────────────────────────────────────────────────
# REQUIRED for the nightly inventory reconcile (vercel.json). Vercel Cron sends it
# as a bearer token; without it the job returns 401 and silently does nothing.
# Any long random string.
CRON_SECRET=generate-a-long-random-string

# ─── App URL ───────────────────────────────────────────────────────────────────
# OAuth redirects derive their origin from the incoming request, so this is NOT
# used for Shopify callbacks — pointing it at localhost once caused the
# "redirect_uri is not whitelisted" rejection. Only set it for absolute links in
# outbound email.
NEXT_PUBLIC_APP_URL=https://www.zyroocloud.com

# ─── WooCommerce ───────────────────────────────────────────────────────────────
# Per-store credentials live on the users table (wc_store_url, wc_consumer_key,
# wc_consumer_secret), not here. These are global only.
NEXT_PUBLIC_WC_STORE_URL=
WC_WEBHOOK_SECRET=

# ─── Daraz ─────────────────────────────────────────────────────────────────────
DARAZ_APP_KEY=
DARAZ_APP_SECRET=

# ─── WhatsApp ──────────────────────────────────────────────────────────────────
# Token you choose; Meta echoes it back when verifying the webhook subscription.
WA_VERIFY_TOKEN=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=

# ─── Google ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=
# Used by the WhatsApp AI bot (@google/genai).
GEMINI_API_KEY=

# ─── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Payments ──────────────────────────────────────────────────────────────────
# Note: charging through the Shopify App Store requires the Shopify Billing API,
# not Stripe, per requirement 1.2.
STRIPE_SECRET_KEY=

# ─── Not read by the application ───────────────────────────────────────────────
# These appear in some .env.local files but no code references them. They are
# leftovers from when integrations used one global store per deployment; Shopify,
# WooCommerce and Daraz credentials are now per-merchant rows on the users table.
# Listed so they are recognised as stale rather than assumed load-bearing:
#   SHOPIFY_ACCESS_TOKEN, SHOPIFY_STORE_DOMAIN
#   WC_STORE_URL, WC_CONSUMER_KEY, WC_CONSUMER_SECRET
#   DARAZ_ACCESS_TOKEN, DARAZ_REGION
#   GOOGLE_CLIENT_SECRET, INSTAWORLD_API_KEY, POSTEX_API_KEY
# VERCEL_OIDC_TOKEN is injected by Vercel; do not set it by hand.
